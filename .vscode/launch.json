{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 padrão: abre uma segunda janela do VS Code com a extensão carregada,
      // já apontando para o workspace de fixtures. Compila e empacota antes.
      "name": "Executar extensão",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension",
        "--disable-extensions",
        "${workspaceFolder}/packages/extension/test/fixtures/workspace"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/extension/out/**/*.js",
        "${workspaceFolder}/packages/extension/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      // O motor roda em OUTRO PROCESSO (Princípio I), então depurá-lo exige
      // anexar. A porta 6011 é a que client.ts passa em `--inspect` no modo de
      // depuração. Use junto com "Executar extensão" pelo compound abaixo.
      "name": "Anexar ao servidor de linguagem",
      "type": "node",
      "request": "attach",
      "port": 6011,
      "restart": true,
      "outFiles": ["${workspaceFolder}/packages/extension/dist/**/*.js"]
    },
    {
      // Roda os testes de integração dentro de uma instância real do editor.
      // Equivale a `npx vscode-test`, mas com depurador anexado.
      "name": "Testes de integração",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension",
        "--extensionTestsPath=${workspaceFolder}/packages/extension/out/test/integration",
        "${workspaceFolder}/packages/extension/test/fixtures/workspace"
      ],
      "outFiles": ["${workspaceFolder}/packages/extension/out/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ],
  "compounds": [
    {
      "name": "Extensão + servidor",
      "configurations": ["Executar extensão", "Anexar ao servidor de linguagem"],
      "stopAll": true
    }
  ]
}
