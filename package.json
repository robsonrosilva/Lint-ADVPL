{
  "name": "advpl-lint-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Extensão VS Code de lint e formatação ADVPL/TLPP",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/server",
    "packages/extension",
    "packages/tooling"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "build": "npm run typecheck && node packages/tooling/scripts/bundle.mjs",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node packages/tooling/scripts/test-unit.mjs",
    "test:integration": "npm run build && vscode-test",
    "check:nls": "node packages/tooling/out/src/checks/nls-cli.js",
    "check:corpus": "node packages/tooling/out/src/checks/corpus-cli.js",
    "check:docs": "node packages/tooling/out/src/checks/docs-cli.js",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run check:nls && npm run check:corpus && npm run check:docs",
    "baseline": "node packages/tooling/out/src/harness/baseline-cli.js",
    "fixture:large": "node packages/tooling/out/src/fixtures/large-cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
